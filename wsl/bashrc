# ubuntu-wsl

# =====================================================================
# SYSTEM CORE & INTERACTIVE SESSION
# =====================================================================
case $- in
    *i*) ;;
      *) return;;
esac

if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
    debian_chroot=$(cat /etc/debian_chroot)
fi

if ! shopt -oq posix; then
  if [ -f /usr/share/bash-completion/bash_completion ]; then
    . /usr/share/bash-completion/bash_completion
  elif [ -f /etc/bash_completion ]; then
    . /etc/bash_completion
  fi
fi

if [ -f ~/.bash_aliases ]; then
    . ~/.bash_aliases
fi

# =====================================================================
# TERMINAL HISTORY & WINDOW SETTINGS
# =====================================================================
HISTCONTROL=ignoreboth
shopt -s histappend
HISTSIZE=1000
HISTFILESIZE=2000
shopt -s checkwinsize

# =====================================================================
# ENVIRONMENT PATHS
# =====================================================================
[ -x /usr/bin/lesspipe ] && eval "$(SHELL=/bin/sh lesspipe)"
export PATH="$HOME/.local/bin:$PATH"

# =====================================================================
# CUSTOM PROMPT & DISPLAYS
# =====================================================================
# Helper function to retrieve the active Git branch
parse_git_branch() {
    git branch 2>/dev/null | sed -e '/^[^*]/d' -e 's/* \(.*\)/(\1)/'
}

# Prompt definition: user (green), directory (blue), git branch (yellow)
PS1='\[\e]0;\u: \w\a\]${debian_chroot:+($debian_chroot)}\[\033[01;32m\]\u\[\033[00m\]:\[\033[01;34m\]\w\[\033[01;33m\]$(parse_git_branch)\[\033[00m\]\$ '

# =====================================================================
# SYSTEM ALIASES
# =====================================================================
if [ -x /usr/bin/dircolors ]; then
    test -r ~/.dircolors && eval "$(dircolors -b ~/.dircolors)" || eval "$(dircolors -b)"
    alias ls='ls --color=auto'
    alias grep='grep --color=auto'
    alias fgrep='fgrep --color=auto'
    alias egrep='egrep --color=auto'
fi

alias ll='ls -alF'
alias la='ls -A'
alias l='ls -CF'

# =====================================================================
# USER CUSTOM ALIASES & FUNCTIONS
# =====================================================================
alias vim='nvim'
alias cdd='cd /home/gdaza/Desktop'
alias cdw='cd /mnt/c/Users/ginoD'
alias cdwd='cd /mnt/c/Users/ginoD/Desktop'
alias rm='trash'
alias bat='batcat'

cdl() {
  cd "${1:-.}" && ls
}

saveclip() {
  local target="${1:-/tmp/clip.png}"
  local win_target
  win_target=$(wslpath -w "$target")
  powershell.exe -NoProfile -Command "
    Add-Type -AssemblyName System.Windows.Forms;
    if ([System.Windows.Forms.Clipboard]::ContainsImage()) {
      \$img = [System.Windows.Forms.Clipboard]::GetImage();
      \$img.Save('$win_target', [System.Drawing.Imaging.ImageFormat]::Png);
      Write-Host 'Image saved';
    } else {
      Write-Error 'No image in clipboard';
      exit 1;
    }
  " > /dev/null
  if [ $? -eq 0 ]; then
    echo "$target"
  fi
}
. "$HOME/.cargo/env"

# =====================================================================
# DEFAULT STARTING DIRECTORY
# =====================================================================
if [ "$PWD" = "$HOME" ]; then
    cd ~/Desktop/ 2>/dev/null
fi

open() {
    if [ -z "$1" ]; then
        explorer.exe .
    elif [[ "$1" =~ ^https?:// ]]; then
        explorer.exe "$1"
    else
        explorer.exe "$(wslpath -w "$1")"
    fi
}
